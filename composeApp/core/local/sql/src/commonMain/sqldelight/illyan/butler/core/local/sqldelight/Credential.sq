CREATE TABLE credentials (
    providerUrl TEXT PRIMARY KEY NOT NULL,
    apiKey TEXT NOT NULL
);

CREATE TABLE user_tokens (
    userId TEXT PRIMARY KEY NOT NULL,
    accessToken TEXT,
    refreshToken TEXT,
    accessTokenExpirationTime INTEGER,
    refreshTokenExpirationTime INTEGER
);

insertOrReplaceCredential:
INSERT OR REPLACE INTO credentials(providerUrl, apiKey)
VALUES (?, ?);

selectAllCredentials:
SELECT * FROM credentials;

deleteCredential:
DELETE FROM credentials WHERE providerUrl = ?;

deleteAllCredentials:
DELETE FROM credentials;

insertOrReplaceUserTokens:
INSERT OR REPLACE INTO user_tokens(userId, accessToken, refreshToken, accessTokenExpirationTime, refreshTokenExpirationTime)
VALUES (?, ?, ?, ?, ?);

selectUserTokens:
SELECT * FROM user_tokens WHERE userId = ?;
